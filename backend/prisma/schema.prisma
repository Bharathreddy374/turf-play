// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int            @id @default(autoincrement())
  fullname        String
  email           String         @unique
  pass            String?
  profileImageUrl String?
  role            String         @default("user") // "user" or "admin"
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  turfs           Turf[]         @relation("TurfOwner")
  bookings        Booking[]      @relation("UserBookings")
  refreshTokens   RefreshToken[] @relation("UserRefreshTokens")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Turf {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  location     String
  address      String?
  city         String
  state        String?
  pincode      String?
  latitude     Float?
  longitude    Float?
  images       String[] // Array of image URLs
  pricePerHour Float
  sportTypes   String[] // e.g., ["football", "cricket", "basketball"]
  amenities    String[] // e.g., ["parking", "changing room", "floodlights"]
  openTime     String   // e.g., "06:00"
  closeTime    String   // e.g., "22:00"
  isActive     Boolean  @default(true)
  ownerId      Int
  owner        User     @relation("TurfOwner", fields: [ownerId], references: [id])
  bookings     Booking[] @relation("TurfBookings")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Booking {
  id         Int      @id @default(autoincrement())
  userId     Int
  turfId     Int
  date       String   // e.g., "2026-02-15"
  startTime  String   // e.g., "09:00"
  endTime    String   // e.g., "10:00"
  totalPrice Float
  status     String   @default("pending") // "pending", "confirmed", "cancelled", "completed"
  notes      String?
  user       User     @relation("UserBookings", fields: [userId], references: [id])
  turf       Turf     @relation("TurfBookings", fields: [turfId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([turfId, date])
  @@index([userId])
}
